# Server Port (Default: 3000)
PORT=3000

# Application Base URL
APP_URL=http://localhost:3000

# Authentication Secret for signing JWT tokens
JWT_SECRET=zawadi_super_secret_jwt_key_2026_change_in_production

# PostgreSQL Database Configuration
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://zawadi_user:zawadi_password@localhost:5432/zawadi_db
# Or individual Cloud SQL / Postgres connection parameters:
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=zawadi_user
SQL_PASSWORD=zawadi_password
SQL_DB_NAME=zawadi_db

# Safaricom M-Pesa Daraja API Credentials
# MPESA_ENVIRONMENT: 'sandbox' or 'production'
MPESA_ENVIRONMENT=sandbox

